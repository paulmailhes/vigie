#!/bin/bash -p
# Vigie — lanceur de Claude Code pour l'extension VS Code (réglage claudeCode.claudeProcessWrapper).
#
# L'extension l'appelle ainsi : <ce script> <binaire claude intégré> <arguments…>.
# Pour une conversation (--input-format stream-json), il choisit le compte d'après data/accounts.json :
#   - le compte noté pour cette conversation ;
#   - sinon (conversation neuve, ou reprise jamais associée) : le compte des nouvelles conversations (defaultForNew) ;
#   - ce compte ne marche pas (pas connecté d'après data/connexions.json, publié par le coffre du moteur, dossier
#     absent, historique non relié) : le premier qui marche parmi le défaut, Travail 1 et les autres, noté
#     « repli:<voulu>:<raison> » (la conversation reste associée à son compte, elle y revient à la reprise suivante) ;
#   - Travail 1 déconnecté : une conversation neuve part dessus (« connexion-du-mac »). L'extension ne regarde que
#     ce compte pour dire « connecté » : sa connexion (une conversation neuve) doit l'atteindre.
# Un compte autre que Travail 1 = CLAUDE_CONFIG_DIR=<son dossier>, écrit exactement comme dans accounts.json :
# le nom de l'entrée de trousseau en dépend. Il coupe aussi les connecteurs claude.ai si Vigie le demande.
# Les appels annexes (auth status, mcp, sonde de configuration…) partent tels quels, donc sur Travail 1 ;
# « auth logout » et « auth login » sont notés (le coffre ne remet pas une connexion que l'utilisateur retire).
# Règle d'or : à la moindre erreur, on lance le binaire avec ses arguments d'origine, sans rien changer.
# Le journal (data/launches.log) ne garde que l'heure, le pid, le compte, l'id de conversation et la raison :
# jamais les arguments, qui peuvent contenir des jetons (--mcp-config).
# « -p » : ni BASH_ENV ni fonctions exportées ne peuvent s'inviter ici. Bash 3.2 (celui de macOS).

case "$1" in
  '') echo "claude-account-wrapper : binaire manquant" >&2; exit 127 ;;
  -*) bin=claude ;;            # pas de binaire intégré transmis : celui du PATH, comme l'extension
  *) bin="$1"; shift ;;
esac

JQ=/usr/bin/jq
MAIN=travail1
NL='
'
UUID_RE='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
H="${VIGIE_HOME:-$HOME}"
V_KIND=""; V_ACC=""; V_DIR=""; V_CONN=""; V_SID=""; V_WHY=""; V_MODE=""; V_REWRITE=0; U_WHY=""
V_ARGS=()
US=$'\037' # séparateur des champs d'un compte candidat (jamais dans un chemin raisonnable, jamais un blanc)

# Choix du compte, des connecteurs et du mode de permission, en une lecture (jq : ~3 ms).
# Sorties, une par ligne : connecteurs (off|on|garder), mode par défaut de ~/.claude/settings.json, compte voulu,
# raison, puis les comptes candidats dans l'ordre (voulu, défaut, Travail 1, les autres) :
# « id US dossier (vide = Travail 1) US connecté d'après le coffre (1|0) US connu (1|0) », puis « fin » pour
# vérifier que rien n'a été tronqué. L'état du coffre ne compte que s'il a moins de 15 min (moteur vivant).
PROG='
def j: try fromjson catch null;
def str: if type == "string" then . else null end;
def uniq: reduce .[] as $x ([]; if any(.[]; . == $x) then . else . + [$x] end);
(if type == "object" then . else error("comptes") end) as $m
| [ ($m.accounts // [])[] | select(type == "object" and (.id | type) == "string") ] as $acc
| (($m.sessions // {}) | if type == "object" then . else {} end) as $map
| (($m.defaultForNew | str) // $main) as $def
| (if $sid != "" then ($map[$sid] | str) else null end) as $mapped
| ($cx | j) as $x
| (if ($x | type) == "object" and (($x.checkedAtEpoch | type) == "number")
      and (now - $x.checkedAtEpoch) < 900 and (now - $x.checkedAtEpoch) > -900
      and (($x.accounts | type) == "object") then $x.accounts else {} end) as $live
| def up($id): ($live[$id] | if type == "object" then .connected else null end) != false;
  (if $mapped != null then {id: $mapped, why: "choisi"}
   elif $isnew == "1" then {id: $def, why: "nouvelle"}
   else {id: $def, why: "sans-choix"} end) as $want0
| (if $isnew == "1" and (up($main) | not) then {id: $main, why: "connexion-du-mac"} else $want0 end) as $want
| ($st | j) as $s
| ($se | j) as $set
| (if ($s | type) != "object" then "garder"
   else ((if $sid != "" then (($s.sessions // {}) | if type == "object" then (.[$sid] // {}) else {} end
                              | if type == "object" then (.connectors | str) else null end)
          else null end)
         // ($s.connectorsDefault | str) // "off") end) as $c
| (([ $want.id, $def, $main ] + [ $acc[].id ]) | uniq) as $ids
| [ $c,
    (if ($set | type) == "object"
     then (($set.permissions // {}) | if type == "object" then ((.defaultMode | str) // "") else "" end)
     else "" end),
    $want.id,
    $want.why ]
  + [ $ids[] as $id
      | ([ $acc[] | select(.id == $id) ] | first) as $a
      | [ $id,
          (if $id == $main or $a == null then "" else (($a.configDir | str) // "") end),
          (if up($id) or ($want.why == "connexion-du-mac" and $id == $main) then "1" else "0" end),
          (if $a != null or $id == $main then "1" else "0" end) ]
      | map(gsub("[\u001f\n]"; " ")) | join("\u001f") ]
  + [ "fin" ]
| map(gsub("\n"; " ")) | .[]
'

# Un compte candidat marche-t-il ? (id, dossier, connecté d'après le coffre, connu) ; sinon U_WHY dit pourquoi.
vigie_usable() {
  U_WHY=""
  [ "$4" = 1 ] || { U_WHY=compte-inconnu; return 1; }
  if [ -n "$2" ]; then
    case "$2" in */) U_WHY=chemin; return 1 ;; /*) ;; *) U_WHY=chemin; return 1 ;; esac
    [ -d "$2" ] || { U_WHY=dossier-absent; return 1; }
    # historique partagé indispensable : sans lui l'extension repartirait d'une conversation vide
    if ! { [ -L "$2/projects" ] && [ "$2/projects" -ef "$H/.claude/projects" ]; }; then U_WHY=historique-non-relie; return 1; fi
    "$JQ" -e '(.oauthAccount | type) == "object"' "$2/.claude.json" >/dev/null 2>&1 || { U_WHY=non-connecte; return 1; }
  fi
  [ "$3" = 1 ] || { U_WHY=non-connecte; return 1; }
  return 0
}

# Dossier data/ : VIGIE_DATA, sinon à côté du script (liens symboliques résolus).
vigie_data() {
  if [ -n "$VIGIE_DATA" ]; then printf '%s' "$VIGIE_DATA"; return 0; fi
  local src="${BASH_SOURCE[0]}" dir n=0
  while [ -L "$src" ] && [ $n -lt 20 ]; do
    case "$src" in */*) dir="${src%/*}" ;; *) dir=. ;; esac
    dir=$(CDPATH= cd -P "$dir" 2>/dev/null && pwd) || return 1
    src=$(/usr/bin/readlink "$src") || return 1
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
    n=$((n + 1))
  done
  case "$src" in */*) dir="${src%/*}" ;; *) dir=. ;; esac
  dir=$(CDPATH= cd -P "$dir/.." 2>/dev/null && pwd) || return 1
  printf '%s/data' "$dir"
}

# Avec un lanceur, l'extension impose « default » quand l'onglet n'a pas de mode à elle.
# On rend alors le mode de ~/.claude/settings.json (par exemple auto), sauf si l'utilisateur a lui-même choisi
# « default » : mode de départ fixé dans VS Code, ou dernier mode retenu par l'extension.
vigie_mode_libre() {
  local vs="${VIGIE_VSCODE_SETTINGS:-$H/Library/Application Support/Code/User/settings.json}"
  if [ -f "$vs" ] && /usr/bin/grep -q '"claudeCode.initialPermissionMode"' "$vs" 2>/dev/null; then return 1; fi
  local db="${VIGIE_VSCODE_STATE_DB:-$H/Library/Application Support/Code/User/globalStorage/state.vscdb}" m
  [ -r "$db" ] || return 1
  m=$(/usr/bin/sqlite3 -readonly -cmd '.timeout 300' "$db" \
    "select json_extract(value, '\$.defaultPermissionMode') from ItemTable where key in ('Anthropic.claude-code', 'anthropic.claude-code') limit 1;" 2>/dev/null) || return 1
  case "$m" in default|manual) return 1 ;; esac
  return 0
}

vigie_route() {
  # Sonde de configuration de l'extension : ce n'est pas une conversation.
  [ -n "$CLAUDE_CODE_CONFIG_PROBE" ] && return 1
  # Déconnexion et connexion de l'extension : passent telles quelles, mais notées pour le coffre.
  if [ "$1" = auth ]; then
    case "$2" in logout) V_KIND=annexe; V_WHY=deconnexion ;; login) V_KIND=annexe; V_WHY=connexion ;; esac
    return 1
  fi
  local a prev="" stream=0 resume=0 pm="" isnew=1 out rest dm end fix=0 want line cid cdir cup cknown first=1 wfail=""
  for a in "$@"; do
    case "$prev" in
      --input-format) [ "$a" = stream-json ] && stream=1 ;;
      --resume) V_SID="$a" ;;
      --session-id) [ "$resume" = 1 ] || V_SID="$a" ;;
      --permission-mode) pm="$a" ;;
    esac
    case "$a" in
      --input-format=stream-json) stream=1 ;;
      --resume) resume=1; V_SID="" ;;
      --resume=*) resume=1; V_SID="${a#--resume=}" ;;
      --session-id=*) [ "$resume" = 1 ] || V_SID="${a#--session-id=}" ;;
      --continue) resume=2 ;;
      --permission-mode=*) pm="${a#--permission-mode=}" ;;
    esac
    prev="$a"
  done
  [ "$stream" = 1 ] || return 1
  V_KIND=conv
  if [ "$resume" = 2 ]; then V_SID=""; V_WHY=continuer; return 1; fi
  if ! [[ $V_SID =~ $UUID_RE ]]; then
    # reprise d'autre chose qu'un id (chemin…) : on ne devine pas
    if [ "$resume" = 1 ]; then V_SID=""; V_WHY=reprise-illisible; return 1; fi
    V_SID=""
  fi
  [ "$resume" = 1 ] && isnew=0
  [ -n "$DATA" ] || { V_WHY=sans-data; return 1; }
  [ -x "$JQ" ] || { V_WHY=sans-jq; return 1; }
  local acc="$DATA/accounts.json" st="$DATA/state.json" se="$H/.claude/settings.json" cx="$DATA/connexions.json"
  [ -f "$acc" ] || { V_WHY=sans-comptes; return 1; }
  [ -r "$st" ] || st=/dev/null
  [ -r "$se" ] || se=/dev/null
  [ -r "$cx" ] || cx=/dev/null
  out=$("$JQ" -r --arg sid "$V_SID" --arg isnew "$isnew" --arg main "$MAIN" \
        --rawfile st "$st" --rawfile se "$se" --rawfile cx "$cx" "$PROG" "$acc" 2>/dev/null) || { V_WHY=comptes-illisibles; return 1; }
  rest="$out$NL"
  V_CONN="${rest%%"$NL"*}"; rest="${rest#*"$NL"}"
  dm="${rest%%"$NL"*}"; rest="${rest#*"$NL"}"
  want="${rest%%"$NL"*}"; rest="${rest#*"$NL"}"
  V_WHY="${rest%%"$NL"*}"; rest="${rest#*"$NL"}"
  # Premier candidat qui marche ; le premier est toujours le compte voulu.
  while [ -n "$rest" ]; do
    line="${rest%%"$NL"*}"; rest="${rest#*"$NL"}"
    if [ "$line" = fin ]; then end=fin; break; fi
    case "$line" in *"$US"*"$US"*"$US"*) ;; *) break ;; esac
    cid="${line%%"$US"*}"; line="${line#*"$US"}"
    cdir="${line%%"$US"*}"; line="${line#*"$US"}"
    cup="${line%%"$US"*}"; cknown="${line#*"$US"}"
    if [ -z "$V_ACC" ]; then
      if vigie_usable "$cid" "$cdir" "$cup" "$cknown"; then V_ACC="$cid"; V_DIR="$cdir"
      elif [ "$first" = 1 ]; then wfail="$U_WHY"; fi
    fi
    first=0
  done
  if [ "$end" != fin ] || [ -z "$want" ]; then V_ACC=""; V_DIR=""; V_WHY=comptes-illisibles; return 1; fi
  if [ -n "$wfail" ]; then V_WHY="repli:$want:$wfail"; fi
  # aucun compte ne marche : Travail 1 tel quel (Claude Code y proposera de se connecter)
  [ -n "$V_ACC" ] || return 1

  if [ "$pm" = default ]; then
    case "$dm" in
      auto|acceptEdits)
        if vigie_mode_libre; then
          V_MODE="$dm"; V_REWRITE=1
          for a in "$@"; do
            if [ "$fix" = 1 ]; then
              fix=0
              [ "$a" = default ] && a="$V_MODE"
              V_ARGS+=("$a")
              continue
            fi
            case "$a" in
              --permission-mode=default) V_ARGS+=("--permission-mode=$V_MODE") ;;
              --permission-mode) V_ARGS+=("$a"); fix=1 ;;
              *) V_ARGS+=("$a") ;;
            esac
          done
        fi ;;
    esac
  fi
  return 0
}

# Une ligne par conversation lancée : « epoch  pid  compte  conversation|-  raison ».
# data/launches/<pid> : le serveur y lit sur quel compte tourne chaque processus (exec garde le pid)
# et épingle les conversations neuves. data/launches.log : l'historique, pour comprendre après coup.
# Troisième argument « annexe » : pas de fiche de processus (ce n'est pas une conversation).
vigie_log() {
  [ -n "$DATA" ] && [ -d "$DATA" ] || return 0
  local f="$DATA/launches.log" sz line
  line="$(/bin/date +%s)	$$	$1	${V_SID:--}	$2"
  if [ "$3" != annexe ]; then
    [ -d "$DATA/launches" ] || /bin/mkdir -p "$DATA/launches" 2>/dev/null
    printf '%s\n' "$line" > "$DATA/launches/$$" 2>/dev/null
  fi
  if [ -f "$f" ]; then
    sz=$(/usr/bin/stat -f %z "$f" 2>/dev/null)
    if [ "${sz:-0}" -gt 262144 ] 2>/dev/null; then
      /usr/bin/tail -n 400 "$f" > "$f.$$" 2>/dev/null && /bin/mv -f "$f.$$" "$f" 2>/dev/null
    fi
  fi
  printf '%s\n' "$line" >> "$f" 2>/dev/null
  return 0
}

DATA=$(vigie_data 2>/dev/null) || DATA=""

if vigie_route "$@"; then
  vigie_log "$V_ACC" "$V_WHY"
  # Travail 1 = ~/.claude : une variable héritée (VS Code lancé depuis un terminal de compte) n'a rien à faire ici.
  if [ -n "$V_DIR" ]; then export CLAUDE_CONFIG_DIR="$V_DIR"; else unset CLAUDE_CONFIG_DIR; fi
  if [ "$V_CONN" = off ]; then export ENABLE_CLAUDEAI_MCP_SERVERS=false; fi
  if [ "$V_REWRITE" = 1 ]; then exec "$bin" "${V_ARGS[@]}"; fi
  exec "$bin" "$@"
fi
if [ "$V_KIND" = conv ]; then vigie_log "$MAIN" "${V_WHY:-repli}"; fi
# Appel annexe : sur Travail 1, sauf si l'extension elle-même tourne avec un autre dossier (compte alors inconnu).
if [ "$V_KIND" = annexe ]; then vigie_log "$([ -z "$CLAUDE_CONFIG_DIR" ] && printf %s "$MAIN" || printf -)" "$V_WHY" annexe; fi
exec "$bin" "$@"
